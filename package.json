{
  "name": "nufa-media",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build && playwright test",
    "studio": "npm run dev --workspace=@nufa/studio",
    "studio:build": "npm run build --workspace=@nufa/studio",
    "cms:seed": "node scripts/seed-sanity.mjs",
    "check": "npm test && npm run studio:build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.2.6",
    "@fontsource/plus-jakarta-sans": "^5.2.6",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanity": "^6.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "workspaces": [
    "studio"
  ]
}
